# Скопируйте в .env.local и заполните
SESSION_SECRET=            # случайная строка 32+ символов
ADMIN_LOGIN=admin
ADMIN_PASSWORD=            # пароль входа в /admin
SITE_URL=http://localhost:3000   # на проде — https://ваш-домен (canonical, sitemap, OG)
GOOGLE_SITE_VERIFICATION=  # код из Google Search Console
YANDEX_VERIFICATION=       # код из Яндекс.Вебмастера
GOOGLE_PLACES_API_KEY=     # ключ Google Places API (New) — рейтинг и отзывы Google на сайте
CRON_SECRET=               # токен для cron: POST /api/reviews/sync (автообновление отзывов)
